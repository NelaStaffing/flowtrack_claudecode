# Supabase Configuration
VITE_SUPABASE_URL=your-project-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Claude AI Configuration
# Get your API key from: https://console.anthropic.com/
VITE_CLAUDE_API_KEY=your-claude-api-key-here

# AI Configuration
# Set to 'true' to use Supabase Edge Functions for AI (recommended for production)
# Set to 'false' to use mock data
VITE_USE_AI_EDGE_FUNCTION=false

# Email Configuration (Resend.com)
# Email is sent via Supabase Edge Function - configure secrets in Supabase dashboard:
# RESEND_API_KEY - Your Resend API key (get from resend.com)
# FROM_EMAIL - Email address to send from (e.g., FlowTrack <onboarding@yourdomain.com>)
# These are server-side secrets, not exposed to the client

# App Configuration
VITE_APP_NAME=FlowTrack
VITE_APP_ENV=development
VITE_APP_URL=http://localhost:5173
