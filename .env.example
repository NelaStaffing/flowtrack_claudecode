# Supabase Configuration
VITE_SUPABASE_URL=your-project-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Claude AI Configuration
# Get your API key from: https://console.anthropic.com/
VITE_CLAUDE_API_KEY=your-claude-api-key-here

# AI Configuration
# Set to 'true' to use Supabase Edge Functions for AI (recommended for production)
# Set to 'false' to use mock data
VITE_USE_AI_EDGE_FUNCTION=false

# Email Configuration (Resend.com)
# Sign up at https://resend.com to get your API key
# Used for sending team invitation emails
VITE_RESEND_API_KEY=re_your_api_key_here
VITE_FROM_EMAIL=FlowTrack <onboarding@yourdomain.com>

# App Configuration
VITE_APP_NAME=FlowTrack
VITE_APP_ENV=development
VITE_APP_URL=http://localhost:5173
